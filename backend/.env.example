# PulseGPT Environment Configuration Example
# Copy this file to .env or pass as environment variables

# Server Configuration
SERVER_PORT=8080
SPRING_PROFILES_ACTIVE=dev

# PostgreSQL Database Configuration
DB_HOST=localhost
DB_PORT=5432
DB_NAME=pulsegpt_db
DB_USERNAME=postgres
DB_PASSWORD=postgres
DB_POOL_MAX_SIZE=10

# Security & JWT Configuration
JWT_SECRET=your_super_secret_jwt_key_that_is_at_least_256_bits_long_for_hmac_sha256_pulsegpt_2026
JWT_EXPIRATION_MS=86400000
JWT_REFRESH_EXPIRATION_MS=604800000

# CORS Allowed Origins (Comma-separated)
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000

# YouTube OAuth & Data API Integration (Phase 3F)
YOUTUBE_CLIENT_ID=your_google_oauth_client_id.apps.googleusercontent.com
YOUTUBE_CLIENT_SECRET=your_google_oauth_client_secret
YOUTUBE_REDIRECT_URI=http://localhost:8080/api/v1/integrations/youtube/callback
YOUTUBE_TOKEN_ENCRYPTION_KEY=your_32_byte_aes_key_0123456789012345
YOUTUBE_INITIAL_SYNC_DAYS=90
YOUTUBE_MAX_VIDEOS_PER_SYNC=50
YOUTUBE_MAX_COMMENTS_PER_VIDEO=100
YOUTUBE_QUOTA_LIMIT=10000

# AI / NLP Processing Service (Phase 3G)
AI_SERVICE_BASE_URL=http://localhost:8000
AI_SERVICE_API_KEY=pulse-internal-secret-key-3f8a9e
AI_SERVICE_TIMEOUT_MS=10000
AI_SERVICE_MAX_BATCH_SIZE=32
